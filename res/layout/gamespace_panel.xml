<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gamespace_panel"
    android:clipChildren="true"
    android:elevation="16dp"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/quick_launch_container"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:orientation="vertical" />

    <ScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="292dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Panel Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/panel_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gamespace_gamepad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panel_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/gamespace_tile_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/panel_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/close_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_gamespace_button_secondary"
                    android:clickable="true"
                    android:contentDescription="@string/panel_close"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_panel_close" />
            </LinearLayout>

            <!-- Notifications Container -->
            <LinearLayout
                android:id="@+id/notification_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 2x3 Tiles Grid -->
            <GridLayout
                android:id="@+id/tile_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:rowOrderPreserved="false"
                android:useDefaultMargins="false">

                <!-- FPS Tile -->
                <LinearLayout
                    android:id="@+id/fps_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/fps_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_fps" />

                        <TextView
                            android:id="@+id/fps_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/fps_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fps_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/fps_tile_placeholder"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- System Tile -->
                <LinearLayout
                    android:id="@+id/system_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/system_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_system" />

                        <TextView
                            android:id="@+id/system_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/system_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/system_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/system_tile_placeholder"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- DND Tile -->
                <LinearLayout
                    android:id="@+id/dnd_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/dnd_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_dnd" />

                        <TextView
                            android:id="@+id/dnd_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/dnd_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dnd_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/panel_dnd_off"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Compact Notifications Tile -->
                <LinearLayout
                    android:id="@+id/compact_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/compact_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_notifications" />

                        <TextView
                            android:id="@+id/compact_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/compact_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/compact_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/panel_compact_off"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Call Handling Tile -->
                <LinearLayout
                    android:id="@+id/call_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/call_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_call" />

                        <TextView
                            android:id="@+id/call_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/call_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/call_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/panel_calls_off"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Settings Tile -->
                <LinearLayout
                    android:id="@+id/settings_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_gamespace_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="58dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/settings_tile_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tile_settings" />

                        <TextView
                            android:id="@+id/settings_tile_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/settings_tile_title"
                            android:textColor="@color/gamespace_tile_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_tile_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/settings_tile_summary"
                        android:textColor="@color/gamespace_tile_summary"
                        android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
